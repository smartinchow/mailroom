# Postgres superuser password for the bundled container
POSTGRES_PASSWORD=change-me

# 64-char hex AES-256-GCM key for carrier configs. Generate:
#   openssl rand -hex 32
# Key-versioned form "v2:<hex>" supported; old decrypt-only keys in
# MAILROOM_ENCRYPTION_KEYS_OLD as comma-separated "id:<hex>".
MAILROOM_ENCRYPTION_KEY=
MAILROOM_ENCRYPTION_KEYS_OLD=

# Public base URL of the API (used to build webhook URLs shown in the UI)
PUBLIC_URL=https://mailroom.example.com

# Random secrets. Generate each with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_API_TOKEN=
HOOK_SECRET=
WEB_SESSION_SECRET=

# Dashboard operator password
ADMIN_PASSWORD=

# Host ports
API_PORT=3000
WEB_PORT=3001
LOG_LEVEL=info
